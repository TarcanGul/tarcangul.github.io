---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/site.css';
const { title, description, compactImages = false } = Astro.props.frontmatter;
---
<html>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <style is:global>
            main {
                width: 60%;
            }

            .blog-desc {
                margin-bottom: 2vh;
            }

            .blog-post {
                li {
                    position: relative;
                    left: 20px;
                    line-height:32px;
                    text-align: left;
                }

                ul {
                    margin-top: 20px;
                    margin-bottom: 20px;
                }

                p {
                    text-align: initial;
                    margin-bottom: 2rem;
                    line-height: 2rem;
                }

                table {
                    font-size: inherit;
                    line-height: 2rem;
                    border-collapse: collapse;
                    margin-bottom: 2rem;
                }

                th, td {
                    border: 1px solid rgba(0, 0, 0, 0.2);
                    padding: 0.5rem 0.75rem;
                }

                a::after {
                    max-height: 1px;
                }

                h2 {
                    margin-top: 24px;
                    margin-bottom: 24px;
                }

                code:not(pre code) {
                    color: var(--ternary);
                    background-color: black;
                    padding: 6px;
                    border-radius: 20px;
                }

                pre {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    border-radius: 20px;
                    text-align: left;
                    padding-left: 24px;
                    margin-bottom: 2em;
                    margin-top: 2em;
                }

                /* Code blocks with links */
                a > code {
                    color: var(--code-link) !important;
                    background-color: transparent !important;
                    padding: 0 !important;
                    border-radius: 20px !important;
                }

                img {
                    margin-top: 2em;
                    margin-bottom: 2em;
                    width: 100%;
                    height: 100%;
                }
            }

            .blog-post .blog-video {
                display: block;
                width: 75%;
                max-width: 540px;
                height: auto;
                aspect-ratio: 16 / 9;
                border: 0;
                margin: 0 auto 1rem;
            }

            .blog-post .blog-video-caption {
                text-align: center;
            }

            .blog-post.compact-images img {
                display: block;
                width: 320px;
                max-width: 100%;
                height: auto;
                margin: 1.5rem auto;
            }

            @media screen and (max-width: 700px) {
                main {
                    width: 90%;
                }
            }

            @media screen and (700px < width < 1200px) {
                main {
                    width: 80%;
                }
            }
        </style>
    </head>
    <body>
        <header>
            <Navigation />
        </header>
        <main>
            <h1 class="blog-title">{title}</h1>
            <p class="italic blog-desc">{description}</p>
            <hr>
            <br />
            <div class:list={['blog-post', { 'compact-images': compactImages }]}>
                <slot /> 
            </div>
        </main>
        <Footer />
    </body>
</html>
